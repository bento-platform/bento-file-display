{
  "name": "bento-file-display",
  "version": "0.5.1",
  "description": "TypeScript component for displaying files in Bento front-ends.",
  "homepage": "https://github.com/bento-platform/bento-file-display#readme",
  "bugs": {
    "url": "https://github.com/bento-platform/bento-file-display/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bento-platform/bento-file-display.git"
  },
  "license": "LGPL-3.0-only",
  "author": "David Lougheed <david.lougheed@mail.mcgill.ca>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && npx tsc && npm run copy-files",
    "clean": "rm -rf ./dist",
    "copy-files": "cp ./src/*.css ./dist/",
    "fix-imports": "npx ts-add-js-extension --dir=./dist",
    "lint": "npx eslint src",
    "lint:fix": "npx eslint src --fix",
    "test": "npx webpack-dev-server"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "papaparse": "^5.5.3",
    "react-error-boundary": "^6.1.2",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "react-syntax-highlighter": "^16.1.0",
    "react18-json-view": "^0.2.9",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.4.0 || ^6.3.2",
    "antd": "^5.28.1 || ^6.5.3",
    "react": "^18.3.1 || ^19.0.8",
    "react-dom": "^18.3.1 || ^19.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/papaparse": "^5.5.0",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^8.57.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.3.3",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "style-loader": "^4.0.0",
    "ts-add-js-extension": "^1.6.6",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
